# Gemini API key (Google AI Studio / Generative Language API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Random 32+ char secret used to HMAC-sign guest progress tokens
SESSION_SECRET=change-me-to-a-random-32-char-secret

# PIN for the Host / Gift-Table Console at /admin
ADMIN_PIN=2026

# Hunt pack configuration ("home-test" for home testing, "angana-courtyard" for wedding day)
DEFAULT_HUNT_ID=home-test
ALLOW_HUNT_SWITCH=true

# Optional: Vercel KV / Upstash Redis REST credentials for atomic winner locking across serverless instances
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
